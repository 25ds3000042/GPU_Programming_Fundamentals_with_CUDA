      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Image size\n",
        "width = 800\n",
        "height = 600"
      ],
      "metadata": {
        "id": "314_XeFdPeKM"
      },
      "execution_count": 10,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Julia Set constant\n",
        "c = complex(-0.7, 0.27015)"
      ],
      "metadata": {
        "id": "BeBxSlKoSzN7"
      },
      "execution_count": 11,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Create coordinates for every pixel\n",
        "x = np.linspace(-2, 2, width)\n",
        "y = np.linspace(-1.5, 1.5, height)\n",
        "\n",
        "X, Y = np.meshgrid(x, y)"
      ],
      "metadata": {
        "id": "Ga7ynNthS13d"
      },
      "execution_count": 12,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Convert coordinates into complex numbers\n",
        "Z = X + 1j * Y"
      ],
      "metadata": {
        "id": "Ppgx6G7NS4zP"
      },
      "execution_count": 13,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Number of iterations\n",
        "iterations = 100"
      ],
      "metadata": {
        "id": "qUW7sdstS7iE"
      },
      "execution_count": 14,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Calculate Julia Set\n",
        "for i in range(iterations):\n",
        "    Z = Z**2 + c"
      ],
